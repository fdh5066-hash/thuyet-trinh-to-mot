    { q: "Câu 35. Công việc nào sau đây thuộc lĩnh vực điện dân dụng?", options: ["Lắp đặt hệ thống đèn chiếu sáng và ổ cắm trong nhà ở.", "Vận hành turbine nhà máy nhiệt điện.", "Sửa chữa đường dây 500kV Bắc - Nam.", "Chế tạo robot công nghiệp."], correct: 0 },
    { q: "Câu 36. Bạn Nam rất thích lắp ráp các mạch điện nhỏ, thích tìm hiểu sơ đồ nguyên lý của các thiết bị điện trong nhà và mơ ước sau này thiết kế hệ thống điện thông minh cho các tòa nhà. Nam nên định hướng trở thành:", options: ["Kĩ sư điện.", "Thợ sửa chữa điện lạnh.", "Nhân viên kinh doanh thiết bị điện.", "Công nhân vận hành lưới điện."], correct: 0 },
    { q: "Câu 37. Giả sử bạn là một kĩ thuật viên điện đang bảo trì máy sản xuất, bạn phát hiện dây nguồn của máy bị hở lớp cách điện. Hành động đúng đắn và an toàn nhất là:", options: ["Lấy băng dính thường quấn sơ qua rồi cho máy chạy tiếp để kịp tiến độ.", "Báo cáo ngắt nguồn điện, treo biển cảnh báo, rồi tiến hành thay thế hoặc bọc lại bằng băng keo cách điện chuyên dụng.", "Lờ đi vì đó không phải là việc của mình.", "Dùng tay trần kiểm tra xem có bị giật không."], correct: 1 },
    { q: "Câu 38. Xu hướng 'Lưới điện thông minh' (Smart Grid) trong tương lai đòi hỏi người kĩ sư điện phải tích hợp thêm kiến thức chuyên môn nào?", options: ["Kĩ năng nấu ăn công nghiệp.", "Công nghệ thông tin, viễn thông và chuyển đổi số.", "Kiến thức về kiến trúc cổ điển.", "Kĩ năng cơ khí đúc hàn."], correct: 1 },
    { q: "Câu 39. Một người thợ điện có tay nghề cao, muốn tự mở một cửa hàng chuyên sửa chữa, quấn motor và lắp đặt điện gia đình thì cần chứng chỉ hoặc điều kiện gì tối thiểu?", options: ["Bằng Tiến sĩ ngành Điện.", "Chứng chỉ nghề phù hợp và giấy phép đăng ký kinh doanh.", "Chứng chỉ ngoại ngữ IELTS 7.0.", "Không cần điều kiện gì, cứ mở là được."], correct: 1 },
    { q: "Câu 40. Tại sao trong các nhà máy sản xuất, vị trí 'Kĩ sư/Kĩ thuật viên bảo trì điện' lại cực kỳ quan trọng và không thể thiếu?", options: ["Vì họ là người trực tiếp làm ra sản phẩm bán cho khách hàng.", "Vì họ đảm bảo máy móc hoạt động liên tục, giảm thiểu thời gian dừng máy gây thiệt hại kinh tế.", "Vì họ quản lý chấm công cho công nhân.", "Vì họ chịu trách nhiệm tiếp khách cho công ty."], correct: 1 },
    { q: "Câu 41. Nếu một học sinh có tính cách nóng nảy, cẩu thả, hay quên thì có phù hợp làm việc trong ngành kĩ thuật điện không? Tại sao?", options: ["Có, vì ngành này cần sự nhanh nhẹn.", "Không, vì sự cẩu thả trong ngành điện rất dễ dẫn đến tai nạn chết người hoặc cháy nổ nghiêm trọng.", "Có, vì máy móc sẽ tự động sửa lỗi cho con người.", "Không, vì ngành này chỉ tuyển người có bằng giỏi."], correct: 1 },
    { q: "Câu 42. Khi tham quan một trạm biến áp 110kV, bạn thấy các kĩ sư vận hành phải mặc trang phục gì khi làm việc tại khu vực sân phân phối?", options: ["Quần áo bảo hộ thông thường bằng vải nilon.", "Quần áo bảo hộ chống hồ quang điện, giày cách điện, mũ bảo hộ theo tiêu chuẩn.", "Trang phục thể thao thoải mái.", "Áo mưa để tránh bụi bẩn."], correct: 1 },
    { q: "Câu 43. Công việc của một 'Kĩ sư giám sát thi công điện' tại một công trình xây dựng chung cư bao gồm:", options: ["Trực tiếp đi dây điện vào từng căn hộ.", "Kiểm tra, đối chiếu tiến độ và chất lượng lắp đặt của nhà thầu so với bản vẽ thiết kế đã duyệt.", "Bán căn hộ cho khách hàng.", "Lái xe chở vật liệu điện đến công trình."], correct: 1 },
    { q: "Câu 44. Thuộc tính nào sau đây thể hiện tư duy thiết kế của một Kĩ sư điện khi lập kế hoạch cấp điện cho một khu dân cư mới?", options: ["Tính toán để hệ thống có chi phí rẻ nhất bất chấp độ an toàn.", "Dự báo nhu cầu phụ tải tương lai, đảm bảo độ tin cậy, an toàn và tối ưu chi phí.", "Chọn thiết bị theo sở thích cá nhân của mình.", "Sao chép nguyên văn thiết kế của một khu dân cư ở nước ngoài mà không cần tính toán lại."], correct: 1 },
    { q: "Câu 45. Điểm khác biệt lớn nhất về môi trường làm việc của Thợ điện dân dụng và Thợ điện công nghiệp là gì?", options: ["Thợ điện dân dụng kiếm được nhiều tiền hơn.", "Thợ điện dân dụng làm việc tại nhà dân/công trình nhỏ; thợ điện công nghiệp làm việc tại nhà máy, xí nghiệp với thiết bị công suất lớn.", "Thợ điện công nghiệp không cần mặc đồ bảo hộ.", "Thợ điện dân dụng bắt buộc phải có bằng đại học."], correct: 1 },
    { q: "Câu 46. Sự xuất hiện của xe ô tô điện (EV) đang mở ra hướng đi mới nào cho ngành kĩ thuật điện?", options: ["Chế tạo thêm nhiều cây xăng.", "Nghiên cứu, chế tạo hệ thống pin, trạm sạc và động cơ điện cho xe.", "Phát triển ngành lọc dầu.", "Không ảnh hưởng gì đến ngành điện."], correct: 1 },
    { q: "Câu 47. Lý do chính khiến việc học thực hành (tại xưởng, phòng thí nghiệm) chiếm tỷ trọng rất lớn trong chương trình đào tạo ngành kĩ thuật điện là:", options: ["Để học sinh đỡ phải đọc sách lý thuyết nhàm chán.", "Giúp người học hình thành kĩ năng thao tác thực tế chính xác và phản xạ an toàn khi tiếp xúc với thiết bị thật.", "Vì thiết bị điện rất rẻ nên dễ trang bị cho học sinh phá thoải mái.", "Để nhà trường dễ quản lý học sinh hơn."], correct: 1 },
    { q: "Câu 48. Đâu là một thách thức lớn đối với những người thợ sửa chữa đường dây cao thế (thợ đường dây dây truyền tải)?", options: ["Phải làm việc hoàn toàn trong môi trường không trọng lực.", "Đối mặt với nguy hiểm khi làm việc ở độ cao hàng chục mét, thời tiết khắc nghiệt (nắng nóng, gió bão).", "Thường xuyên bị ô nhiễm tiếng ồn từ còi xe đô thị.", "Không có cơ hội thăng tiến nghề nghiệp."], correct: 1 },
    { q: "Câu 49. Một doanh nghiệp muốn tuyển dụng vị trí 'Trưởng phòng Kĩ thuật Điện'. Ứng viên nào dưới đây có lợi thế nhất?", options: ["Người có bằng trung cấp nghề điện và 1 năm kinh nghiệm.", "Người tốt nghiệp đại học ngành Quản trị kinh doanh nhưng thích đồ điện.", "Người có bằng Kĩ sư Điện, có năng lực quản lý và nhiều năm kinh nghiệm thực tế trong ngành.", "Người vừa tốt nghiệp Tiến sĩ lý thuyết ngành Vật lý hạt nhân."], correct: 2 },
    { q: "Câu 50. Việc áp dụng các robot tự động đi kiểm tra đường dây truyền tải điện giúp thay thế con người ở điểm nào?", options: ["Thay thế hoàn toàn tư duy của kĩ sư điện.", "Giảm thiểu rủi ro tai nạn cho thợ điện khi phải trèo cao kiểm tra thủ công.", "Làm tăng chi phí vận hành lưới điện lên gấp nhiều lần.", "Khiến ngành kĩ thuật điện biến mất trong tương lai."], correct: 1 }
];
